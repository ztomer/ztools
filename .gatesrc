# gates_of_heck configuration. All keys optional; delete what you don't use.
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# vendor/camoufox-rs is a third-party crate carried in-tree (rust/Cargo.toml
# path dependency; the tap builds from the tarball). Not ours to split or
# re-glyph; still secret-scanned by the length/emoji-independent checks.
export GOH_EXCLUDE='vendor/'
# GOH_LINE_EXCLUDE='third_party/'       # length-only alias
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25           # disk-hygiene ceiling (full runs only)

# The gate of record. `tools/gate.sh --full` (the pre-push hook) and `make ci`
# both delegate to gates/local_ci.sh, which reads this -- ONE list, so the hook
# can never be weaker than CI.
#
# COVERAGE FLOOR: 95, the house floor. Measured 95.65% by the house gate
# (2026-09-14). What remains uncovered is `cli_ztools.rs`'s model-eval run
# loop and the live twitter scrape -- code that takes the machine-wide GPU
# lock and drives a headless browser against a live model server. It is a
# ratchet: raise it, never lower it.
#
# Steps are COLON-separated by the runner, so no step string may contain a
# colon -- hence $GOH_DIR resolved here.
export GOH_DIR="${GOH_DIR:-$HOME/Projects/gates_of_heck}"
GOH_CI_STEPS='"$GOH_DIR/gates/rust_gate.sh" . rust:cargo audit --file rust/Cargo.lock:"$GOH_DIR/gates/structural.sh" --full:cargo test --manifest-path rust/Cargo.toml --all-features:python3 -m pytest tools/tests -q:"$GOH_DIR/gates/coverage_gate.sh" --lang rust --floor 95 rust'
