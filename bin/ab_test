#!/usr/bin/env bash
# Smoke + parity harness for the native `ztools` binary.
#
# Until 2026-09-13 this was an A/B between the Rust binary and the Python
# reference implementations (CLI surface timing, behavioural parity, collect
# parity). The Python side is retired; what remains is the half that still
# measures something:
#   1. CLI surface: every subcommand answers --help, with launch timing.
#   2. The Rust suite (unit, integration and the frozen-golden parity tests).
#   3. Collect parity: the shared-record comparator over its fixtures, plus the
#      live-run wiring notes (the comparator itself is a python3 stdlib script,
#      a dev tool like tools/*.py -- never on the product path).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="python3"

RUST=""
if command -v ztools >/dev/null 2>&1 && [ "$(head -c 2 "$(command -v ztools)")" != '#!' ]; then
    RUST="ztools"
elif [ -x "$ROOT/bin/ztools" ]; then
    RUST="$ROOT/bin/ztools"
fi
if [ -z "$RUST" ]; then
    echo "✗ ztools binary not found — building release binary..." >&2
    (cd "$ROOT/rust" && cargo build --quiet --release)
    RUST="$ROOT/bin/ztools"
fi

echo "============================================================"
echo "              ZTOOLS SMOKE + PARITY HARNESS                 "
echo "============================================================"
echo ""

failures=0

now_ms() { perl -MTime::HiRes=time -e 'printf "%.0f\n", time()*1000'; }

run_cli_test() {
    local name="$1" subcommand="$2" expect="$3"

    echo "------------------------------------------------------------"
    echo "CLI Surface: $name"
    echo "------------------------------------------------------------"

    local t0 t1 rust_ms rust_status
    t0=$(now_ms)
    "$RUST" "$subcommand" --help > /tmp/rust_output.txt 2>&1 && rust_status=0 || rust_status=$?
    t1=$(now_ms)
    rust_ms=$((t1 - t0))
    if [ "$rust_status" -eq 0 ] && grep -qi "$expect" /tmp/rust_output.txt; then
        echo "  ✓ $subcommand --help answers in ${rust_ms}ms"
    else
        echo "  ✗ $subcommand --help failed (exit $rust_status) or lacks '$expect'"
        failures=$((failures + 1))
    fi
    echo ""
}

run_rust_suite() {
    echo "------------------------------------------------------------"
    echo "Rust suite (unit, integration, frozen-golden parity)"
    echo "------------------------------------------------------------"
    if (cd "$ROOT/rust" && cargo test --quiet); then
        echo "  ✓ Rust ztools unit, integration & parity tests passed"
    else
        echo "  ✗ Rust ztools tests failed"
        failures=$((failures + 1))
    fi
    echo ""
}

compare_collect_records() {
    # Record parity over the tweets BOTH legs saw. Set equality was the first
    # criterion here and it was the wrong instrument: measured 2026-09-13, the
    # SAME Rust collector run twice minutes apart on the same account and 24h
    # window shared 7 of ~50 IDs, so cross-implementation overlap (1-3) is
    # inside the feed's own sampling noise. X serves the Following endpoint as
    # a per-load sample; no two loads see the same tweets. What IS
    # deterministic is the record built from a tweet both legs captured:
    # author, text and timestamp must agree byte-for-byte. Engagement counts
    # are live and drift between loads, so they are checked for presence only.
    #
    # Exit 0: every shared record agrees. Exit 1: a shared record differs, or
    # an input is unreadable. Exit 2: nothing shared — inconclusive, rerun.
    local rust_file="$1" py_file="$2"
    (cd "$ROOT" && "$PY" -c '
import json, sys
from datetime import datetime
rust_file, py_file = sys.argv[1], sys.argv[2]
try:
    rust = json.load(open(rust_file, encoding="utf-8"))
    py = json.load(open(py_file, encoding="utf-8"))
except (OSError, ValueError) as e:
    print(f"  ✗ cannot read collect outputs: {e}")
    sys.exit(1)
assert isinstance(rust, list) and isinstance(py, list), "both files must hold JSON arrays"

def when(raw):
    # Rust writes the GraphQL form, Python ISO-8601; both name one instant.
    for fmt in ("%a %b %d %H:%M:%S %z %Y", "%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%dT%H:%M:%S"):
        try:
            return datetime.strptime(str(raw), fmt).isoformat()
        except ValueError:
            pass
    return f"unparsed:{raw}"

rust_by = {str(t.get("id", "")): t for t in rust if isinstance(t, dict) and str(t.get("id", ""))}
py_by = {str(t.get("id_str") or t.get("id") or ""): t for t in py if isinstance(t, dict) and str(t.get("id_str") or t.get("id") or "")}
rust_blind = sum(1 for t in rust if isinstance(t, dict) and not str(t.get("id", "")))
py_blind = sum(1 for t in py if isinstance(t, dict) and not str(t.get("id_str") or t.get("id") or ""))
if rust_blind or py_blind:
    print(f"  ! {rust_blind} Rust / {py_blind} Python tweets carry no ID (excluded)")
shared = sorted(set(rust_by) & set(py_by))
print(f"  · {len(rust_by)} Rust / {len(py_by)} Python tweets, {len(shared)} shared")
if not shared:
    print("  ! no shared tweets — inconclusive (the feed is sampled per load; rerun both legs closer together)")
    sys.exit(2)
LIVE_COUNTS = ("favorite_count", "retweet_count")
bad = 0
for tid in shared:
    r, q = rust_by[tid], py_by[tid]
    diffs = [k for k in ("screen_name", "text") if r.get(k) != q.get(k)]
    if when(r.get("created_at")) != when(q.get("created_at")):
        diffs.append("created_at")
    diffs += [k for k in LIVE_COUNTS if (k in r) != (k in q)]
    if diffs:
        bad += 1
        print(f"  ✗ {tid}: {chr(44).join(diffs)} differ")
        for k in diffs:
            print(f"      rust={r.get(k)!r}\n      py  ={q.get(k)!r}")
if bad:
    print(f"  ✗ {bad} of {len(shared)} shared records differ")
    sys.exit(1)
print(f"  ✓ all {len(shared)} shared records agree (author, text, timestamp; live counts present on both)")
sys.exit(0)
' "$rust_file" "$py_file")
}

run_collect_parity() {
    echo "------------------------------------------------------------"
    echo "Collect Parity: shared-record agreement (fixtures + live wiring)"
    echo "------------------------------------------------------------"
    local fixdir="$ROOT/tests/fixtures/collect_parity"

    # Green path: identical records on both sides must pass.
    if compare_collect_records "$fixdir/rust_a.json" "$fixdir/py_a.json"; then
        echo "  ✓ Fixture pair agrees (green path)"
    else
        echo "  ✗ Fixture pair disagrees — the comparator or fixtures drifted"
        failures=$((failures + 1))
    fi

    # Partial overlap with agreeing shared records is parity, not drift: the
    # feed is a per-load sample (see compare_collect_records).
    if compare_collect_records "$fixdir/rust_a.json" "$fixdir/py_b.json" >/dev/null 2>&1; then
        echo "  ✓ Partial overlap with agreeing records passes (sampled feed)"
    else
        echo "  ✗ Comparator failed a partial overlap whose shared records agree"
        failures=$((failures + 1))
    fi

    # E3 red-proof: a shared tweet whose record differs must FAIL. A
    # comparator that cannot go red would green-light exactly the parse drift
    # this gate exists to catch.
    if compare_collect_records "$fixdir/rust_a.json" "$fixdir/py_c.json" >/dev/null 2>&1; then
        echo "  ✗ Comparator accepted a differing shared record — it cannot bite"
        failures=$((failures + 1))
    else
        echo "  ✓ Comparator rejects a differing shared record (red-proof)"
    fi

    # Disjoint legs are inconclusive (exit 2), never a pass.
    compare_collect_records "$fixdir/rust_a.json" "$fixdir/py_d.json" >/dev/null 2>&1
    if [ $? -eq 2 ]; then
        echo "  ✓ Disjoint legs report inconclusive, not parity"
    else
        echo "  ✗ Disjoint legs did not report inconclusive"
        failures=$((failures + 1))
    fi

    # Live-run wiring. The Python leg is retired; the comparator now serves two
    # RUST runs (e.g. before/after a collector change, or two machines), whose
    # caches both carry `id`:
    #   ztools twitter-summarize --fetch-only --since 24h
    #   cp ~/.twitter_summary_debug_cache.json /tmp/ab_before.json
    #   ... change ...
    #   ztools twitter-summarize --fetch-only --since 24h
    #   cp ~/.twitter_summary_debug_cache.json /tmp/ab_after.json
    #   compare_collect_records /tmp/ab_before.json /tmp/ab_after.json
    # The feed is a per-load sample (measured: the same collector minutes apart
    # shared 7 of ~50 IDs), so only the shared records are compared.
    echo ""
}

run_cli_test "Twitter Summarizer" twitter-summarize "usage"
run_cli_test "Weekend Planner"    weekend-plan     "usage"
run_cli_test "Image Renamer"      image-renamer    "usage"
run_cli_test "Model Quality Benchmark" model-eval  "usage"
run_cli_test "Weekend status"     status           "usage"
run_cli_test "Twitter status"     twitter-status   "usage"

run_rust_suite
run_collect_parity

echo "============================================================"
if [ "$failures" -eq 0 ]; then
    echo "               SMOKE + PARITY HARNESS OK              "
    echo "============================================================"
else
    echo "        HARNESS FAILED — $failures check(s) did not pass     "
    echo "============================================================"
    exit 1
fi
