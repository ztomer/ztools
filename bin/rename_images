#!/usr/bin/env bash
# ZTools wrapper: execs the uv-managed venv console script for this tool.
# `rename_images` operates on the current directory by default (mirrors the old
# zsh function, which passed $PWD). The venv is built by the Homebrew formula at
# install time; if it is missing this wrapper self-heals from pkgshare source.
set -euo pipefail

TOOL="rn"
EXTRA="vision"

SELF="$(readlink -f "${BASH_SOURCE[0]:-$0}")"
PREFIX="$(cd "$(dirname "$SELF")/.." && pwd)"
LIBEXEC="$PREFIX/libexec/ztools"
VENV="$LIBEXEC/venv"
SRC="$PREFIX/share/ztools"
PY="$VENV/bin/python"

if [ ! -x "$PY" ]; then
  echo "→ bootstrapping rename_images venv (one-time)..." >&2
  command -v uv >/dev/null 2>&1 || { echo "✗ uv is required: https://docs.astral.sh/uv/" >&2; exit 1; }
  mkdir -p "$LIBEXEC"
  uv venv "$VENV" >&2
  if [ -d "$SRC" ]; then
    uv pip install --python "$PY" "$SRC/.[$EXTRA]" >&2
  else
    uv pip install --python "$PY" "otools[$EXTRA]" >&2
  fi
fi

exec "$VENV/bin/$TOOL" "$PWD" "$@"
