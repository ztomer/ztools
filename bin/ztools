#!/usr/bin/env bash
# Fast shim to the native Rust `routines` binary.
set -euo pipefail

if command -v routines >/dev/null 2>&1; then
  exec routines "$@"
fi
DEV_BUILD="$HOME/Projects/routines/target/release/routines"
if [ -x "$DEV_BUILD" ]; then
  exec "$DEV_BUILD" "$@"
fi
echo "✗ routines binary not found on PATH (and no dev build at $DEV_BUILD)" >&2
exit 1
