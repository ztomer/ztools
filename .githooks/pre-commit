#!/usr/bin/env python3
"""Pre-commit hook: fast local checks before allowing a commit.

Runs in under 2s for typical changes:
1. Emoji gate — only Kare icon set (→ ✓ ✗ ⚠ ↔ ↑ ↓) is permitted.
2. Config-debt gate — block NEW hardcoded paths/URLs/emails.
3. ruff check on staged .py files.
4. Python syntax check (py_compile) on staged .py files.
5. File size gate — reject new files over 500 lines.
"""

import re
import subprocess
import sys
from pathlib import Path

# The hook is invoked via an absolute core.hooksPath, so __file__ always points at the
# MAIN checkout even when committing from a linked worktree. Resolve the tree being
# committed from git itself; otherwise every check reads the wrong files and the wrong index.
HOOK_ROOT = Path(__file__).resolve().parent.parent


def _repo_root() -> Path:
    r = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    )
    if r.returncode == 0 and r.stdout.strip():
        return Path(r.stdout.strip())
    return HOOK_ROOT


ROOT = _repo_root()


def _tool(rel: str) -> Path:
    """Prefer the tree being committed; fall back to the main checkout."""
    p = ROOT / rel
    return p if p.exists() else HOOK_ROOT / rel


def get_staged() -> list[str]:
    r = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, cwd=str(ROOT),
    )
    return [f for f in r.stdout.strip().split("\n") if f]


def get_staged_py() -> list[str]:
    return [f for f in get_staged() if f.endswith(".py")]


def get_added_lines(file_path: str) -> set[int]:
    r = subprocess.run(
        ["git", "diff", "--cached", "-U0", file_path],
        capture_output=True, text=True, cwd=str(ROOT),
    )
    added = set()
    for line in r.stdout.split("\n"):
        m = re.match(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@", line)
        if m:
            start = int(m.group(1))
            count = int(m.group(2)) if m.group(2) else 1
            for i in range(start, start + count):
                added.add(i)
    return added


ruff_path = _tool(".venv/bin/ruff")
ruff_cmd = str(ruff_path) if ruff_path.exists() else "ruff"

staged_files = get_staged()
staged_py = get_staged_py()
errors = []

# --- 1. Emoji gate ---
EMOJI_CHECKER = _tool("tools/check_no_emoji.py")
if EMOJI_CHECKER.exists():
    r = subprocess.run(
        [sys.executable, str(EMOJI_CHECKER), "--staged"],
        capture_output=True, text=True, cwd=str(ROOT),
    )
    if r.returncode != 0:
        errors.append("  Emoji gate FAILED:")
        for line in r.stdout.strip().split("\n"):
            if line.strip():
                errors.append(f"    {line}")

# --- 2. File size gate (500-line limit, no exemptions) ---
# Delegated to tools/check_file_size.py so ONE implementation covers every
# language. It used to be inlined here and filtered `f.endswith(".py")`, so the
# Rust port inherited none of the cap and the hook still printed green. It also
# used to exempt test files; that carve-out is gone too — see the File Size
# Limit rule in CLAUDE.md. references/tests/test_file_size_gate.py pins both,
# so the gate and the documented rule cannot drift apart again.
SIZE_CHECKER = _tool("tools/check_file_size.py")
if SIZE_CHECKER.exists() and staged_files:
    r = subprocess.run(
        [sys.executable, str(SIZE_CHECKER), *staged_files],
        capture_output=True, text=True, cwd=str(ROOT),
    )
    for line in r.stdout.strip().split("\n"):
        if line.strip():
            errors.append(line)

# --- 3. Config-debt gate ---
CHECKER = _tool("tools/check_config_debt.py")
if CHECKER.exists():
    for f in staged_py:
        added_lines = get_added_lines(f)
        if not added_lines:
            continue
        r = subprocess.run(
            [sys.executable, str(CHECKER), str(ROOT / f)],
            capture_output=True, text=True, cwd=str(ROOT),
        )
        if r.returncode == 0:
            continue
        new_violations = []
        for line in r.stdout.split("\n"):
            m = re.match(r"^\s+L\s*(\d+)", line)
            if m and int(m.group(1)) in added_lines:
                new_violations.append(line)
        if new_violations:
            errors.append(f"  Config debt in {f}:")
            errors.extend(new_violations)

# --- 4. ruff check on staged files ---
if staged_py:
    try:
        ruff_proc = subprocess.run(
            [ruff_cmd, "check", *staged_py],
            capture_output=True, text=True, cwd=str(ROOT),
        )
        if ruff_proc.returncode != 0:
            errors.append("  Ruff linting errors:")
            for line in ruff_proc.stdout.split("\n"):
                if line.strip():
                    errors.append(f"    {line.strip()}")
    except FileNotFoundError:
        pass

# --- 5. Python syntax check ---
for f in staged_py:
    r = subprocess.run(
        [sys.executable, "-m", "py_compile", str(ROOT / f)],
        capture_output=True, text=True, cwd=str(ROOT),
    )
    if r.returncode != 0:
        errors.append(f"  Syntax error in {f}: {r.stderr.strip()}")

# --- 6. Rust checks (clippy & test) ---
staged_rust = [f for f in staged_files if f.startswith("rust/") or f.endswith(".rs") or "Cargo." in f]
if staged_rust and (ROOT / "rust").exists():
    try:
        clippy_proc = subprocess.run(
            ["cargo", "clippy", "--all-targets", "--", "-D", "warnings"],
            capture_output=True, text=True, cwd=str(ROOT / "rust"),
        )
        if clippy_proc.returncode != 0:
            errors.append("  Cargo Clippy check FAILED:")
            for line in clippy_proc.stderr.split("\n"):
                if line.strip():
                    errors.append(f"    {line.strip()}")
        test_proc = subprocess.run(
            ["cargo", "test"],
            capture_output=True, text=True, cwd=str(ROOT / "rust"),
        )
        if test_proc.returncode != 0:
            errors.append("  Cargo Test check FAILED:")
            for line in test_proc.stderr.split("\n"):
                if line.strip():
                    errors.append(f"    {line.strip()}")
    except FileNotFoundError:
        pass

if errors:
    print("Pre-commit checks FAILED:\n")
    print("\n".join(errors))
    print("\nUse --no-verify to bypass (not recommended).")
    sys.exit(1)
