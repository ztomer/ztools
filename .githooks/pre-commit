#!/usr/bin/env python3
"""Pre-commit hook: fast local checks before allowing a commit.

Runs in under 2s for typical changes:
1. Config-debt gate: block NEW hardcoded paths/URLs/emails.
2. ruff check on staged .py files.
3. Python syntax check (py_compile) on staged .py files.
"""

import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

venv_bin = ROOT / ".venv" / "bin"
ruff_cmd = str(venv_bin / "ruff") if (venv_bin / "ruff").exists() else "ruff"

result = subprocess.run(
    ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
    capture_output=True, text=True, cwd=str(ROOT),
)
staged = [f for f in result.stdout.strip().split("\n") if f and f.endswith(".py")]
if not staged:
    sys.exit(0)


def get_added_lines(file_path: str) -> set:
    r = subprocess.run(
        ["git", "diff", "--cached", "-U0", file_path],
        capture_output=True, text=True, cwd=str(ROOT),
    )
    added = set()
    for line in r.stdout.split("\n"):
        m = re.match(r'^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@', line)
        if m:
            start = int(m.group(1))
            count = int(m.group(2)) if m.group(2) else 1
            for i in range(start, start + count):
                added.add(i)
    return added


errors = []

# --- 1. Config-debt gate ---
CHECKER = ROOT / "tools" / "check_config_debt.py"
if CHECKER.exists():
    for f in staged:
        added_lines = get_added_lines(f)
        if not added_lines:
            continue
        r = subprocess.run(
            [sys.executable, str(CHECKER), str(ROOT / f)],
            capture_output=True, text=True, cwd=str(ROOT),
        )
        if r.returncode == 0:
            continue
        new_violations = []
        for line in r.stdout.split("\n"):
            m = re.match(r'^\s+L\s*(\d+)', line)
            if m and int(m.group(1)) in added_lines:
                new_violations.append(line)
        if new_violations:
            errors.append(f"  Config debt in {f}:")
            errors.extend(new_violations)

# --- 2. ruff check on staged files ---
try:
    ruff_proc = subprocess.run(
        [ruff_cmd, "check", *staged],
        capture_output=True, text=True, cwd=str(ROOT),
    )
    if ruff_proc.returncode != 0:
        errors.append("  Ruff linting errors:")
        for line in ruff_proc.stdout.split("\n"):
            if line.strip():
                errors.append(f"    {line.strip()}")
except FileNotFoundError:
    pass

# --- 3. Python syntax check ---
for f in staged:
    r = subprocess.run(
        [sys.executable, "-m", "py_compile", str(ROOT / f)],
        capture_output=True, text=True, cwd=str(ROOT),
    )
    if r.returncode != 0:
        errors.append(f"  Syntax error in {f}: {r.stderr.strip()}")

if errors:
    print("Pre-commit checks FAILED:\n")
    print("\n".join(errors))
    print("\nUse --no-verify to bypass (not recommended).")
    sys.exit(1)
